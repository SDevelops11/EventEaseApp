@model IEnumerable<EventEaseApp.Models.Booking>

@{
    ViewData["Title"] = "Bookings";
    var currentSearch = ViewData["CurrentSearch"] as string;
    var currentStatus = ViewData["CurrentStatus"] as string ?? "All";
    var currentVenueId = ViewData["CurrentVenueId"] as string ?? "All";
    var currentEventTypeId = ViewData["CurrentEventTypeId"] as string ?? "All";
    var currentVenueAvailability = ViewData["CurrentVenueAvailability"] as string ?? "All";
    var currentFromDate = ViewData["CurrentFromDate"] as string;
    var currentToDate = ViewData["CurrentToDate"] as string;

    int totalBookings = ViewData["TotalBookingsCount"] as int? ?? Model.Count();
    decimal totalRevenue = ViewData["TotalRevenue"] as decimal? ?? 0m;
    int confirmedCount = ViewData["ConfirmedCount"] as int? ?? 0;
    int pendingCount = ViewData["PendingCount"] as int? ?? 0;

    bool hasFilters = !string.IsNullOrWhiteSpace(currentSearch) ||
                      (currentStatus != "All" && !string.IsNullOrWhiteSpace(currentStatus)) ||
                      (currentVenueId != "All" && !string.IsNullOrWhiteSpace(currentVenueId)) ||
                      (currentEventTypeId != "All" && !string.IsNullOrWhiteSpace(currentEventTypeId)) ||
                      (currentVenueAvailability != "All" && !string.IsNullOrWhiteSpace(currentVenueAvailability)) ||
                      !string.IsNullOrWhiteSpace(currentFromDate) ||
                      !string.IsNullOrWhiteSpace(currentToDate);
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="h3 fw-bold mb-1 text-gradient"><i class="bi bi-journal-bookmark-fill me-2 text-primary"></i>Consolidated Bookings Hub</h2>
        <p class="text-muted small mb-0">Unified view of event schedules, venue assignments, specialist bookings, and financial analytics.</p>
    </div>
    <div class="d-flex gap-2">
        <div class="btn-group" role="group" aria-label="Consolidated view toggle">
            <button type="button" class="btn btn-outline-primary active" id="btnCardsMode" onclick="setBookingView('cards')">
                <i class="bi bi-grid-1x2-fill me-1"></i> Consolidated Cards
            </button>
            <button type="button" class="btn btn-outline-primary" id="btnTableMode" onclick="setBookingView('table')">
                <i class="bi bi-table me-1"></i> Data Table
            </button>
        </div>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i> Add New Booking</a>
    </div>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Consolidated KPI Analytics Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card glass-card p-3 border-0 h-100">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 bg-primary bg-opacity-10 text-primary">
                    <i class="bi bi-calendar2-week fs-4"></i>
                </div>
                <div>
                    <div class="text-muted extra-small text-uppercase fw-semibold">Total Bookings</div>
                    <div class="fs-4 fw-bold text-dark">@totalBookings</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card glass-card p-3 border-0 h-100">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 bg-success bg-opacity-10 text-success">
                    <i class="bi bi-check-circle-fill fs-4"></i>
                </div>
                <div>
                    <div class="text-muted extra-small text-uppercase fw-semibold">Confirmed</div>
                    <div class="fs-4 fw-bold text-success">@confirmedCount</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card glass-card p-3 border-0 h-100">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 bg-warning bg-opacity-10 text-warning">
                    <i class="bi bi-clock-history fs-4"></i>
                </div>
                <div>
                    <div class="text-muted extra-small text-uppercase fw-semibold">Pending Approval</div>
                    <div class="fs-4 fw-bold text-warning">@pendingCount</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card glass-card p-3 border-0 h-100">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 bg-info bg-opacity-10 text-info">
                    <i class="bi bi-cash-stack fs-4"></i>
                </div>
                <div>
                    <div class="text-muted extra-small text-uppercase fw-semibold">Gross Revenue</div>
                    <div class="fs-4 fw-bold text-dark">R @totalRevenue.ToString("N2")</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Multi-Criteria Advanced Filtering Toolbar (Part 3) -->
<div class="card glass-card p-3 mb-4 shadow-sm border-0">
    <div class="d-flex align-items-center justify-content-between mb-2">
        <span class="small fw-semibold text-primary"><i class="bi bi-funnel-fill me-1"></i>Advanced Multi-Criteria Filtering</span>
        <span class="extra-small text-muted">Filter by Event Type, Venue Availability, Date Range & Status</span>
    </div>

    <form asp-action="Index" method="get" class="row g-2 align-items-end">
        <!-- Search Keyword -->
        <div class="col-md-3 col-sm-6">
            <label class="form-label extra-small text-muted mb-1"><i class="bi bi-search me-1"></i>Search</label>
            <input type="text" name="searchTerm" value="@currentSearch" class="form-control form-control-sm" placeholder="Code, specialist, title..." />
        </div>

        <!-- Event Type Lookup Filter (Part 3 Requirement) -->
        <div class="col-md-2 col-sm-6">
            <label class="form-label extra-small text-muted mb-1"><i class="bi bi-tags me-1"></i>Event Type</label>
            <select name="eventTypeId" class="form-select form-select-sm" asp-items="ViewBag.EventTypesList">
                <option value="All">-- All Types --</option>
            </select>
        </div>

        <!-- Venue Availability Filter (Part 3 Requirement) -->
        <div class="col-md-2 col-sm-6">
            <label class="form-label extra-small text-muted mb-1"><i class="bi bi-check2-square me-1"></i>Venue Availability</label>
            <select name="venueAvailability" class="form-select form-select-sm">
                <option value="All" selected="@(currentVenueAvailability == "All")">-- All Spaces --</option>
                <option value="Available" selected="@(currentVenueAvailability == "Available")">Available Only</option>
                <option value="Unavailable" selected="@(currentVenueAvailability == "Unavailable")">Unavailable</option>
            </select>
        </div>

        <!-- Assigned Venue Filter -->
        <div class="col-md-2 col-sm-6">
            <label class="form-label extra-small text-muted mb-1"><i class="bi bi-bank me-1"></i>Venue</label>
            <select name="venueId" class="form-select form-select-sm" asp-items="ViewBag.VenuesList">
                <option value="All">-- All Venues --</option>
            </select>
        </div>

        <!-- Status Filter -->
        <div class="col-md-1 col-sm-4">
            <label class="form-label extra-small text-muted mb-1"><i class="bi bi-flag me-1"></i>Status</label>
            <select name="status" class="form-select form-select-sm">
                <option value="All" selected="@(currentStatus == "All")">All</option>
                <option value="Confirmed" selected="@(currentStatus == "Confirmed")">Confirmed</option>
                <option value="Pending" selected="@(currentStatus == "Pending")">Pending</option>
                <option value="Cancelled" selected="@(currentStatus == "Cancelled")">Cancelled</option>
            </select>
        </div>

        <!-- Date Range: From Date -->
        <div class="col-md-1 col-sm-4">
            <label class="form-label extra-small text-muted mb-1"><i class="bi bi-calendar me-1"></i>From</label>
            <input type="date" name="fromDate" value="@currentFromDate" class="form-control form-control-sm px-1" />
        </div>

        <!-- Date Range: To Date -->
        <div class="col-md-1 col-sm-4">
            <label class="form-label extra-small text-muted mb-1"><i class="bi bi-calendar-check me-1"></i>To</label>
            <input type="date" name="toDate" value="@currentToDate" class="form-control form-control-sm px-1" />
        </div>

        <!-- Action Buttons -->
        <div class="col-12 d-flex justify-content-end gap-2 pt-2 border-top mt-2">
            <button type="submit" class="btn btn-primary btn-sm px-3">
                <i class="bi bi-funnel-fill me-1"></i> Apply Filters
            </button>
            @if (hasFilters)
            {
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="Clear Filters">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
                </a>
            }
        </div>
    </form>

    @if (hasFilters)
    {
        <div class="mt-2 pt-2 border-top d-flex align-items-center gap-2 small text-muted flex-wrap">
            <span><i class="bi bi-check2-circle text-success me-1"></i>Active filters:</span>
            <span class="badge bg-primary bg-opacity-10 text-primary">Matched @Model.Count() booking(s)</span>
            @if (!string.IsNullOrWhiteSpace(currentSearch)) { <span class="badge bg-light text-dark border">Term: @currentSearch</span> }
            @if (currentEventTypeId != "All") { <span class="badge bg-info bg-opacity-10 text-info">Type Filter Applied</span> }
            @if (currentVenueAvailability != "All") { <span class="badge bg-success bg-opacity-10 text-success">Availability: @currentVenueAvailability</span> }
            @if (!string.IsNullOrWhiteSpace(currentFromDate) || !string.IsNullOrWhiteSpace(currentToDate)) { <span class="badge bg-secondary bg-opacity-10 text-secondary">Date: @currentFromDate to @currentToDate</span> }
            <a asp-action="Index" class="text-decoration-none text-danger extra-small ms-auto"><i class="bi bi-x-circle me-1"></i>Clear all filters</a>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="card glass-card p-5 text-center text-muted">
        <i class="bi bi-calendar-x display-3 mb-3 text-secondary"></i>
        <h4>No Bookings Found</h4>
        @if (hasFilters)
        {
            <p class="mb-4">No bookings match your selected criteria. Try adjusting your search filters or resetting them.</p>
            <div>
                <a asp-action="Index" class="btn btn-secondary px-4 me-2"><i class="bi bi-arrow-clockwise me-1"></i> Reset Filters</a>
            </div>
        }
        else
        {
            <p class="mb-4">Get started by creating a new booking for an event.</p>
            <div>
                <a asp-action="Create" class="btn btn-primary px-4">Create Booking</a>
            </div>
        }
    </div>
}
else
{
    <!-- 1. Consolidated Master-Detail Cards View (Default) -->
    <div id="bookingCardsView" class="row g-4 mb-5">
        @foreach (var item in Model)
        {
            var hours = (item.EndDate - item.StartDate).TotalHours;
            var hoursFormatted = hours > 0 ? hours.ToString("F1") : "1.0";
            var statusClass = item.Status switch
            {
                "Confirmed" => "badge-active",
                "Pending" => "badge-maintenance",
                "Cancelled" => "badge-cancelled",
                _ => "badge-unassigned"
            };

            var venueImg = string.IsNullOrWhiteSpace(item.Venue?.ImageUrl)
                ? "/images/default-venue.svg"
                : item.Venue.ImageUrl;

            var eventPoster = string.IsNullOrWhiteSpace(item.Event?.ImageUrl)
                ? "https://images.unsplash.com/photo-1511578314322-379afb476865?auto=format&fit=crop&w=300&q=80"
                : item.Event.ImageUrl;

            <div class="col-lg-6">
                <div class="card glass-card h-100 border-0 overflow-hidden shadow-sm d-flex flex-column">
                    <!-- Top Status Bar -->
                    <div class="p-3 bg-light border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <span class="badge bg-dark font-monospace px-2 py-1">@item.BookingCode</span>
                            <span class="badge-premium @statusClass">@item.Status</span>
                            @if (item.Event?.EventType != null)
                            {
                                <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 extra-small">
                                    <i class="bi @(item.Event.EventType.Icon ?? "bi-tag") me-1"></i>@item.Event.EventType.Name
                                </span>
                            }
                        </div>
                        <div class="text-muted small">
                            <i class="bi bi-clock-history me-1 text-primary"></i>
                            <strong>@hoursFormatted hrs</strong> duration
                        </div>
                    </div>

                    <!-- Consolidated Content: Venue & Event side-by-side -->
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <!-- Left: Assigned Venue Summary -->
                            <div class="col-sm-5">
                                <div class="position-relative rounded-3 overflow-hidden border shadow-sm mb-2" style="height: 125px;">
                                    <img src="@venueImg" 
                                         alt="@(item.Venue?.Name ?? "Venue")" 
                                         class="w-100 h-100" 
                                         style="object-fit: cover;"
                                         onerror="this.src='/images/default-venue.svg';" />
                                    <div class="position-absolute bottom-0 start-0 end-0 p-2 bg-dark bg-opacity-75 text-white extra-small">
                                        <div class="fw-bold text-truncate">@(item.Venue?.Name ?? "Unallocated Venue")</div>
                                        <div class="text-white-50"><i class="bi bi-geo-alt text-danger me-1"></i>@(item.Venue?.Location ?? "N/A")</div>
                                    </div>
                                </div>
                                <div class="extra-small text-muted d-flex justify-content-between px-1 mb-1">
                                    <span>Rate: <strong>R @(item.Venue?.HourlyRate.ToString("N0") ?? "0")/hr</strong></span>
                                    <span>Cap: <strong>@(item.Venue?.Capacity ?? 0) pax</strong></span>
                                </div>
                                <div class="text-center">
                                    @if (item.Venue != null && item.Venue.IsAvailable)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 w-100 extra-small py-1">
                                            <i class="bi bi-check-circle-fill me-1"></i>Space Available
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 w-100 extra-small py-1">
                                            <i class="bi bi-x-circle-fill me-1"></i>Space Unavailable
                                        </span>
                                    }
                                </div>
                            </div>

                            <!-- Right: Event & Specialist Specs -->
                            <div class="col-sm-7 d-flex flex-column">
                                <div class="d-flex align-items-start gap-2 mb-2">
                                    <img src="@eventPoster" 
                                         alt="Poster" 
                                         class="rounded-2 shadow-sm flex-shrink-0" 
                                         style="width: 44px; height: 44px; object-fit: cover;"
                                         onerror="this.src='/images/default-venue.svg';" />
                                    <div class="overflow-hidden">
                                        <div class="fw-bold text-dark text-truncate" title="@(item.Event?.Title ?? "Event")">
                                            @(item.Event?.Title ?? "Unnamed Event")
                                        </div>
                                        <div class="text-muted small text-truncate">
                                            <i class="bi bi-person me-1"></i>@(item.Event?.ClientName ?? "N/A")
                                        </div>
                                    </div>
                                </div>

                                <div class="p-2 rounded bg-light border mb-2 small">
                                    <div class="d-flex justify-content-between text-muted extra-small uppercase">
                                        <span>Assigned Specialist</span>
                                        <i class="bi bi-patch-check-fill text-primary"></i>
                                    </div>
                                    <div class="fw-semibold text-dark">@item.SpecialistName</div>
                                </div>

                                <div class="extra-small text-muted mt-auto">
                                    <div><i class="bi bi-calendar-event me-1 text-primary"></i>@item.StartDate.ToString("ddd, dd MMM yyyy HH:mm")</div>
                                    <div><i class="bi bi-arrow-right me-1 text-muted"></i>@item.EndDate.ToString("ddd, dd MMM yyyy HH:mm")</div>
                                </div>
                            </div>
                        </div>

                        <!-- Financial & Actions Footer Bar -->
                        <div class="mt-3 pt-3 border-top d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div>
                                <span class="text-muted extra-small text-uppercase">Total Cost:</span>
                                <span class="fs-5 fw-bold text-success ms-1">R @item.TotalCost.ToString("N2")</span>
                            </div>
                            <div class="d-flex gap-2">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-pencil me-1"></i> Edit
                                </a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Are you sure you want to cancel and delete this booking?');" class="d-inline">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- 2. Consolidated Data Table View -->
    <div id="bookingTableView" class="table-responsive-custom mb-5 d-none">
        <table class="table table-custom table-hover">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Event Details</th>
                    <th>Type</th>
                    <th>Venue Details</th>
                    <th>Availability</th>
                    <th>Specialist</th>
                    <th>Schedule</th>
                    <th>Hours</th>
                    <th class="text-end">Total Cost</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var hours = (item.EndDate - item.StartDate).TotalHours;
                    var hoursFormatted = hours > 0 ? hours.ToString("F1") : "1.0";
                    var statusClass = item.Status switch
                    {
                        "Confirmed" => "badge-active",
                        "Pending" => "badge-maintenance",
                        "Cancelled" => "badge-cancelled",
                        _ => "badge-unassigned"
                    };

                    var venueImg = string.IsNullOrWhiteSpace(item.Venue?.ImageUrl) 
                        ? "/images/default-venue.svg" 
                        : item.Venue.ImageUrl;

                    <tr>
                        <td>
                            <span class="font-monospace fw-bold text-primary">@item.BookingCode</span>
                        </td>
                        <td>
                            <div class="fw-semibold">@(item.Event?.Title ?? "N/A")</div>
                            <div class="text-muted small">@(item.Event?.ClientName ?? "N/A")</div>
                        </td>
                        <td>
                            @if (item.Event?.EventType != null)
                            {
                                <span class="badge bg-light text-dark border">
                                    <i class="bi @(item.Event.EventType.Icon ?? "bi-tag") me-1"></i>@item.Event.EventType.Name
                                </span>
                            }
                            else
                            {
                                <span class="text-muted small">Standard</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <img src="@venueImg" 
                                     alt="@(item.Venue?.Name ?? "Venue")" 
                                     class="rounded-2 shadow-sm flex-shrink-0" 
                                     style="width: 40px; height: 40px; object-fit: cover;"
                                     onerror="this.onerror=null; this.src='/images/default-venue.svg';" />
                                <div>
                                    <div class="fw-semibold">@(item.Venue?.Name ?? "N/A")</div>
                                    <div class="text-muted small">@(item.Venue?.Location ?? "N/A")</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            @if (item.Venue != null && item.Venue.IsAvailable)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">
                                    <i class="bi bi-check-circle-fill me-1"></i>Available
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25">
                                    <i class="bi bi-x-circle-fill me-1"></i>Unavailable
                                </span>
                            }
                        </td>
                        <td>
                            <div class="fw-semibold">@item.SpecialistName</div>
                        </td>
                        <td>
                            <div class="small">
                                <i class="bi bi-calendar-event me-1 text-muted"></i>@item.StartDate.ToString("yyyy-MM-dd HH:mm")
                            </div>
                            <div class="small text-muted">
                                <i class="bi bi-arrow-right-short"></i>@item.EndDate.ToString("yyyy-MM-dd HH:mm")
                            </div>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark fw-medium border">@hoursFormatted hrs</span>
                        </td>
                        <td class="text-end fw-bold text-success">
                            R @item.TotalCost.ToString("N2")
                        </td>
                        <td>
                            <span class="badge-premium @statusClass">@item.Status</span>
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this booking?');" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <script>
        function setBookingView(mode) {
            const cardsView = document.getElementById('bookingCardsView');
            const tableView = document.getElementById('bookingTableView');
            const btnCards = document.getElementById('btnCardsMode');
            const btnTable = document.getElementById('btnTableMode');

            if (mode === 'cards') {
                cardsView.classList.remove('d-none');
                tableView.classList.add('d-none');
                btnCards.classList.add('active');
                btnTable.classList.remove('active');
            } else {
                cardsView.classList.add('d-none');
                tableView.classList.remove('d-none');
                btnCards.classList.remove('active');
                btnTable.classList.add('active');
            }
        }
    </script>
}
