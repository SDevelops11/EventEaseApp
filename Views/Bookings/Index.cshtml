@model IEnumerable<EventEaseApp.Models.Booking>

@{
    ViewData["Title"] = "Bookings";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 fw-bold mb-1 text-gradient"><i class="bi bi-journal-bookmark-fill me-2 text-primary"></i>Event Bookings</h2>
        <p class="text-muted small mb-0">Track and manage active schedules and specialist assignments.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i> Add New Booking</a>
</div>

@if (!Model.Any())
{
    <div class="card glass-card p-5 text-center text-muted">
        <i class="bi bi-calendar-x display-3 mb-3 text-secondary"></i>
        <h4>No Bookings Found</h4>
        <p class="mb-4">Get started by creating a new booking for an event.</p>
        <div>
            <a asp-action="Create" class="btn btn-primary px-4">Create Booking</a>
        </div>
    </div>
}
else
{
    <div class="table-responsive-custom">
        <table class="table table-custom table-hover">
            <thead>
                <tr>
                    <th>Booking Code</th>
                    <th>Event Details</th>
                    <th>Venue Details</th>
                    <th>Specialist Name</th>
                    <th>Schedule Period</th>
                    <th>Hours</th>
                    <th class="text-end">Total Cost</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var hours = (item.EndDate - item.StartDate).TotalHours;
                    var hoursFormatted = hours > 0 ? hours.ToString("F1") : "1.0";
                    var statusClass = item.Status switch
                    {
                        "Confirmed" => "badge-active",
                        "Pending" => "badge-maintenance",
                        "Cancelled" => "badge-cancelled",
                        _ => "badge-unassigned"
                    };

                    <tr>
                        <td>
                            <span class="font-monospace fw-bold text-primary">@item.BookingCode</span>
                        </td>
                        <td>
                            <div class="fw-semibold">@(item.Event?.Title ?? "N/A")</div>
                            <div class="text-muted small">@(item.Event?.ClientName ?? "N/A")</div>
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                @{
                                    var venueImg = string.IsNullOrWhiteSpace(item.Venue?.ImageUrl) 
                                        ? "/images/default-venue.svg" 
                                        : item.Venue.ImageUrl;
                                }
                                <img src="@venueImg" 
                                     alt="@(item.Venue?.Name ?? "Venue")" 
                                     class="rounded-2 shadow-sm flex-shrink-0" 
                                     style="width: 40px; height: 40px; object-fit: cover;"
                                     onerror="this.onerror=null; this.src='/images/default-venue.svg';" />
                                <div>
                                    <div class="fw-semibold">@(item.Venue?.Name ?? "N/A")</div>
                                    <div class="text-muted small">@(item.Venue?.Location ?? "N/A")</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="fw-semibold">@item.SpecialistName</div>
                        </td>
                        <td>
                            <div class="small">
                                <i class="bi bi-calendar-event me-1 text-muted"></i>@item.StartDate.ToString("yyyy-MM-dd HH:mm")
                            </div>
                            <div class="small text-muted">
                                <i class="bi bi-arrow-right-short"></i>@item.EndDate.ToString("yyyy-MM-dd HH:mm")
                            </div>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark fw-medium border">@hoursFormatted hrs</span>
                        </td>
                        <td class="text-end fw-bold">
                            R @item.TotalCost.ToString("N2")
                        </td>
                        <td>
                            <span class="badge-premium @statusClass">@item.Status</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
