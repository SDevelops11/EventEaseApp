@model EventEaseApp.Models.Venue

@{
    ViewData["Title"] = "Add Venue";
}

<div class="row justify-content-center">
    <div class="col-lg-10 col-xl-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="h3 fw-bold mb-0 text-gradient"><i class="bi bi-bank me-2 text-primary"></i>Add New Venue</h2>
            <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i> Back to List</a>
        </div>

        <div class="card glass-card p-4 p-md-5">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                <div class="row g-4">
                    <!-- Left Column: Primary Details -->
                    <div class="col-md-6">
                        <h5 class="fw-semibold text-primary mb-3">Primary Details</h5>
                        
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">Venue Name</label>
                            <input asp-for="Name" class="form-control" placeholder="e.g. Grand Ballroom" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Location" class="form-label">Location Address</label>
                            <input asp-for="Location" class="form-control" placeholder="e.g. 123 Main St, Cape Town" />
                            <span asp-validation-for="Location" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-6 mb-3">
                                <label asp-for="Capacity" class="form-label">Capacity (Pax)</label>
                                <input asp-for="Capacity" type="number" class="form-control" placeholder="e.g. 250" />
                                <span asp-validation-for="Capacity" class="text-danger small"></span>
                            </div>
                            <div class="col-6 mb-3">
                                <label asp-for="HourlyRate" class="form-label">Hourly Rate (R)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0">R</span>
                                    <input asp-for="HourlyRate" class="form-control border-start-0" placeholder="0.00" />
                                </div>
                                <span asp-validation-for="HourlyRate" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Status" class="form-label">Initial Status</label>
                            <select asp-for="Status" class="form-select">
                                <option value="Active">Active</option>
                                <option value="Maintenance">Maintenance</option>
                                <option value="Archived">Archived</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Right Column: Secondary Details -->
                    <div class="col-md-6">
                        <h5 class="fw-semibold text-primary mb-3">Additional Details</h5>

                        <div class="mb-3">
                            <label asp-for="ImageUrl" class="form-label">Image URL</label>
                            <input asp-for="ImageUrl" class="form-control" placeholder="https://example.com/image.jpg" />
                            <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="AmenitiesJson" class="form-label">Amenities (Comma separated list)</label>
                            <input asp-for="AmenitiesJson" class="form-control" placeholder="e.g. Wi-Fi, Projector, Sound System" />
                            <span asp-validation-for="AmenitiesJson" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Describe the layout, unique features, etc..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end mt-4 pt-3 border-top">
                    <button type="submit" class="btn btn-primary px-4 py-2"><i class="bi bi-check-circle-fill me-1"></i> Create Venue</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
