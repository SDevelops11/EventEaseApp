@model EventEaseApp.Models.Venue

@{
    ViewData["Title"] = "Edit Venue";
}

<div class="row justify-content-center">
    <div class="col-lg-10 col-xl-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="h3 fw-bold mb-0 text-gradient"><i class="bi bi-pencil-square me-2 text-primary"></i>Edit Venue</h2>
            <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i> Back to List</a>
        </div>

        <div class="card glass-card p-4 p-md-5">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="All" class="alert alert-danger mb-4" role="alert"></div>

                <div class="row g-4">
                    <!-- Left Column: Primary Details -->
                    <div class="col-md-6">
                        <h5 class="fw-semibold text-primary mb-3"><i class="bi bi-info-circle me-1"></i>Primary Details</h5>
                        
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">Venue Name</label>
                            <input asp-for="Name" class="form-control" placeholder="e.g. Grand Ballroom" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Location" class="form-label">Location Address</label>
                            <input asp-for="Location" class="form-control" placeholder="e.g. 123 Main St, Cape Town" />
                            <span asp-validation-for="Location" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-6 mb-3">
                                <label asp-for="Capacity" class="form-label">Capacity (Pax)</label>
                                <input asp-for="Capacity" type="number" class="form-control" placeholder="e.g. 250" />
                                <span asp-validation-for="Capacity" class="text-danger small"></span>
                            </div>
                            <div class="col-6 mb-3">
                                <label asp-for="HourlyRate" class="form-label">Hourly Rate (R)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0">R</span>
                                    <input asp-for="HourlyRate" class="form-control border-start-0" placeholder="0.00" />
                                </div>
                                <span asp-validation-for="HourlyRate" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Status" class="form-label">Status</label>
                            <select asp-for="Status" class="form-select">
                                <option value="Active">Active</option>
                                <option value="Maintenance">Maintenance</option>
                                <option value="Archived">Archived</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="AmenitiesJson" class="form-label">Amenities (Comma separated list)</label>
                            <input asp-for="AmenitiesJson" class="form-control" placeholder="e.g. Wi-Fi, Projector, Sound System" />
                            <span asp-validation-for="AmenitiesJson" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Right Column: Image & Description -->
                    <div class="col-md-6">
                        <h5 class="fw-semibold text-primary mb-3"><i class="bi bi-image me-1"></i>Venue Imagery</h5>

                        <div class="p-3 mb-3 rounded-3 border bg-light bg-opacity-50">
                            <!-- Current Image Preview -->
                            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                            {
                                <div class="mb-3">
                                    <div class="small fw-semibold text-muted mb-1">Current Venue Photo:</div>
                                    <div class="rounded-3 overflow-hidden border shadow-sm" style="height: 140px; background-color: #f8fafc;">
                                        <img id="currentVenueImg" src="@Model.ImageUrl" alt="@Model.Name" class="w-100 h-100" style="object-fit: cover;" onerror="this.src='/images/default-venue.svg';" />
                                    </div>
                                </div>
                            }

                            <label class="form-label d-flex justify-content-between align-items-center">
                                <span>Upload New Image</span>
                                <span class="badge bg-primary bg-opacity-10 text-primary small"><i class="bi bi-cloud-arrow-up me-1"></i>Azure Storage</span>
                            </label>
                            <input type="file" name="imageFile" id="imageFile" accept="image/*" class="form-control" onchange="previewImage(this, 'editVenueImgPreview', 'editPreviewBox')" />
                            <div class="form-text extra-small text-muted mt-1">
                                Choose a new file to replace the current image in Azure Blob Storage.
                            </div>

                            <div class="text-center my-2 position-relative">
                                <hr class="my-2" />
                                <span class="px-2 bg-light text-muted small position-absolute top-50 start-50 translate-middle">OR</span>
                            </div>

                            <label asp-for="ImageUrl" class="form-label small">Direct / Placeholder Image URL</label>
                            <input asp-for="ImageUrl" id="imageUrlInput" class="form-control form-control-sm" placeholder="https://example.com/venue.jpg" oninput="previewUrl(this.value, 'editVenueImgPreview', 'editPreviewBox')" />
                            <span asp-validation-for="ImageUrl" class="text-danger small"></span>

                            <!-- Dynamic New Image Preview Box -->
                            <div id="editPreviewBox" class="mt-3 text-center d-none">
                                <div class="small fw-semibold text-primary mb-1 text-start">New Image Preview:</div>
                                <div class="rounded-3 overflow-hidden border shadow-sm" style="height: 140px; background-color: #f8fafc;">
                                    <img id="editVenueImgPreview" src="#" alt="New Preview" class="w-100 h-100" style="object-fit: cover;" />
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Describe the layout, unique features, etc..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end mt-4 pt-3 border-top">
                    <button type="submit" class="btn btn-primary px-4 py-2"><i class="bi bi-save me-1"></i> Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewImage(input, imgId, boxId) {
            const preview = document.getElementById(imgId);
            const box = document.getElementById(boxId);
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    preview.src = e.target.result;
                    box.classList.remove('d-none');
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        function previewUrl(url, imgId, boxId) {
            const preview = document.getElementById(imgId);
            const box = document.getElementById(boxId);
            if (url && url.trim().length > 5) {
                preview.src = url.trim();
                box.classList.remove('d-none');
            } else {
                box.classList.add('d-none');
            }
        }
    </script>
}
