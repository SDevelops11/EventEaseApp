@model IEnumerable<EventEaseApp.Models.Venue>

@{
    ViewData["Title"] = "Venues";
    var currentSearch = ViewData["CurrentSearch"] as string;
    var currentStatus = ViewData["CurrentStatus"] as string ?? "All";
    var currentMinCap = ViewData["CurrentMinCapacity"] as int?;
    var currentMaxRate = ViewData["CurrentMaxRate"] as decimal?;
    bool hasFilters = !string.IsNullOrWhiteSpace(currentSearch) || 
                      (currentStatus != "All" && !string.IsNullOrWhiteSpace(currentStatus)) || 
                      currentMinCap.HasValue || 
                      currentMaxRate.HasValue;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="h3 fw-bold mb-1 text-gradient"><i class="bi bi-bank me-2 text-primary"></i>Event Venues</h2>
        <p class="text-muted small mb-0">Browse, filter, and manage available spaces for upcoming events.</p>
    </div>
    <div class="d-flex gap-2">
        <div class="btn-group" role="group" aria-label="View toggle">
            <button type="button" class="btn btn-outline-primary active" id="btnGridView" onclick="toggleView('grid')">
                <i class="bi bi-grid-fill me-1"></i> Cards
            </button>
            <button type="button" class="btn btn-outline-primary" id="btnTableView" onclick="toggleView('table')">
                <i class="bi bi-table me-1"></i> Table
            </button>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Add New Venue
        </a>
    </div>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Multi-Criteria Search & Filter Toolbar -->
<div class="card glass-card p-3 mb-4">
    <form asp-action="Index" method="get" class="row g-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label small text-muted mb-1"><i class="bi bi-search me-1"></i>Search Keyword</label>
            <input type="text" name="searchTerm" value="@currentSearch" class="form-control form-control-sm" placeholder="Search by name, location, keyword..." />
        </div>
        <div class="col-md-2 col-sm-6">
            <label class="form-label small text-muted mb-1"><i class="bi bi-flag me-1"></i>Status</label>
            <select name="status" class="form-select form-select-sm">
                <option value="All" selected="@(currentStatus == "All")">All Statuses</option>
                <option value="Active" selected="@(currentStatus == "Active")">Active</option>
                <option value="Maintenance" selected="@(currentStatus == "Maintenance")">Maintenance</option>
                <option value="Archived" selected="@(currentStatus == "Archived")">Archived</option>
            </select>
        </div>
        <div class="col-md-2 col-sm-6">
            <label class="form-label small text-muted mb-1"><i class="bi bi-people me-1"></i>Min Capacity</label>
            <input type="number" name="minCapacity" value="@currentMinCap" class="form-control form-control-sm" placeholder="e.g. 100" />
        </div>
        <div class="col-md-2 col-sm-6">
            <label class="form-label small text-muted mb-1"><i class="bi bi-cash me-1"></i>Max Rate (R)</label>
            <input type="number" step="50" name="maxRate" value="@currentMaxRate" class="form-control form-control-sm" placeholder="e.g. 2000" />
        </div>
        <div class="col-md-2 col-sm-6 d-flex gap-2">
            <button type="submit" class="btn btn-primary btn-sm flex-fill">
                <i class="bi bi-funnel-fill me-1"></i> Filter
            </button>
            @if (hasFilters)
            {
                <a asp-action="Index" class="btn btn-secondary btn-sm" title="Clear Filters">
                    <i class="bi bi-x-circle"></i>
                </a>
            }
        </div>
    </form>
    
    @if (hasFilters)
    {
        <div class="mt-2 pt-2 border-top d-flex align-items-center gap-2 small text-muted">
            <span><i class="bi bi-check2-circle text-success me-1"></i>Filters active:</span>
            <span class="badge bg-primary bg-opacity-10 text-primary">Found @Model.Count() venue(s)</span>
            <a asp-action="Index" class="text-decoration-none text-danger small ms-auto"><i class="bi bi-arrow-counterclockwise me-1"></i>Reset All Filters</a>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="card glass-card p-5 text-center text-muted">
        <i class="bi bi-building-x display-3 mb-3 text-secondary"></i>
        <h4>No Venues Found</h4>
        @if (hasFilters)
        {
            <p class="mb-4">No venues match your selected search criteria. Try broadening your filters.</p>
            <div>
                <a asp-action="Index" class="btn btn-secondary px-4 me-2"><i class="bi bi-arrow-clockwise me-1"></i> Reset Filters</a>
            </div>
        }
        else
        {
            <p class="mb-4">Get started by creating your first venue space.</p>
            <div>
                <a asp-action="Create" class="btn btn-primary px-4"><i class="bi bi-plus-lg me-1"></i> Add Venue</a>
            </div>
        }
    </div>
}
else
{
    <!-- 1. Grid Card View (Default) -->
    <div id="venuesGridView" class="row g-4 mb-5">
        @foreach (var item in Model)
        {
            var statusBadge = item.Status switch
            {
                "Active" => "badge-active",
                "Maintenance" => "badge-maintenance",
                "Archived" => "badge-archived",
                _ => "badge-active"
            };

            var imgSrc = string.IsNullOrWhiteSpace(item.ImageUrl) 
                ? "/images/default-venue.svg" 
                : item.ImageUrl;

            <div class="col-md-6 col-lg-4">
                <div class="card glass-card h-100 border-0 overflow-hidden d-flex flex-column">
                    <!-- Venue Image Header -->
                    <div class="position-relative overflow-hidden" style="height: 220px; background-color: #f1f5f9;">
                        <img src="@imgSrc" 
                             alt="@item.Name" 
                             class="w-100 h-100" 
                             style="object-fit: cover; transition: transform 0.5s ease;"
                             onerror="this.onerror=null; this.src='/images/default-venue.svg';" />
                        <span class="position-absolute top-0 end-0 m-3 badge-premium @statusBadge shadow-sm">
                            @item.Status
                        </span>
                        <div class="position-absolute bottom-0 start-0 end-0 p-3 bg-dark bg-opacity-50 text-white backdrop-blur">
                            <div class="fw-bold fs-5 text-truncate">@item.Name</div>
                            <div class="small text-white-50"><i class="bi bi-geo-alt me-1 text-info"></i>@item.Location</div>
                        </div>
                    </div>

                    <!-- Card Body -->
                    <div class="card-body d-flex flex-column p-4">
                        @if (!string.IsNullOrWhiteSpace(item.Description))
                        {
                            <p class="card-text text-muted small mb-3 text-line-clamp-2" title="@item.Description">
                                @item.Description
                            </p>
                        }

                        <div class="row g-2 mb-3 mt-auto">
                            <div class="col-6">
                                <div class="p-2 rounded bg-light border text-center">
                                    <div class="text-muted extra-small uppercase">Capacity</div>
                                    <div class="fw-bold text-dark"><i class="bi bi-people me-1 text-primary"></i>@item.Capacity</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-2 rounded bg-light border text-center">
                                    <div class="text-muted extra-small uppercase">Hourly Rate</div>
                                    <div class="fw-bold text-success">R @item.HourlyRate.ToString("N2")</div>
                                </div>
                            </div>
                        </div>

                        <!-- Action Controls -->
                        <div class="pt-3 border-top d-flex justify-content-between align-items-center gap-2">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm flex-fill">
                                <i class="bi bi-pencil me-1"></i> Edit
                            </a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this venue?');" class="flex-fill">
                                <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                                    <i class="bi bi-trash me-1"></i> Delete
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- 2. Table View (Toggled via JS) -->
    <div id="venuesTableView" class="table-responsive-custom mb-5 d-none">
        <table class="table table-custom table-hover">
            <thead>
                <tr>
                    <th>Image</th>
                    <th>Name</th>
                    <th>Location</th>
                    <th>Capacity</th>
                    <th>Hourly Rate</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var statusBadge = item.Status switch
                    {
                        "Active" => "badge-active",
                        "Maintenance" => "badge-maintenance",
                        "Archived" => "badge-archived",
                        _ => "badge-active"
                    };

                    var imgSrc = string.IsNullOrWhiteSpace(item.ImageUrl) 
                        ? "/images/default-venue.svg" 
                        : item.ImageUrl;

                    <tr>
                        <td style="width: 70px;">
                            <img src="@imgSrc" 
                                 alt="@item.Name" 
                                 class="rounded-3 shadow-sm" 
                                 style="width: 50px; height: 50px; object-fit: cover;"
                                 onerror="this.onerror=null; this.src='/images/default-venue.svg';" />
                        </td>
                        <td>
                            <div class="fw-bold text-dark">@item.Name</div>
                            <div class="text-muted extra-small">ID: @item.Id</div>
                        </td>
                        <td>
                            <i class="bi bi-geo-alt text-danger me-1"></i>@item.Location
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border"><i class="bi bi-people me-1"></i>@item.Capacity</span>
                        </td>
                        <td class="fw-bold text-success">
                            R @item.HourlyRate.ToString("N2")
                        </td>
                        <td>
                            <span class="badge-premium @statusBadge">@item.Status</span>
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Are you sure?');" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <script>
        function toggleView(viewType) {
            const gridView = document.getElementById('venuesGridView');
            const tableView = document.getElementById('venuesTableView');
            const btnGrid = document.getElementById('btnGridView');
            const btnTable = document.getElementById('btnTableView');

            if (viewType === 'grid') {
                gridView.classList.remove('d-none');
                tableView.classList.add('d-none');
                btnGrid.classList.add('active');
                btnTable.classList.remove('active');
            } else {
                gridView.classList.add('d-none');
                tableView.classList.remove('d-none');
                btnGrid.classList.remove('active');
                btnTable.classList.add('active');
            }
        }
    </script>
}