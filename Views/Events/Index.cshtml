@model IEnumerable<EventEaseApp.Models.Event>

@{
    ViewData["Title"] = "Events";
    var currentSearch = ViewData["CurrentSearch"] as string;
    var currentStatus = ViewData["CurrentStatus"] as string ?? "All";
    var currentVenueId = ViewData["CurrentVenueId"] as string ?? "All";
    var currentFromDate = ViewData["CurrentFromDate"] as string;
    var currentToDate = ViewData["CurrentToDate"] as string;

    bool hasFilters = !string.IsNullOrWhiteSpace(currentSearch) ||
                      (currentStatus != "All" && !string.IsNullOrWhiteSpace(currentStatus)) ||
                      (currentVenueId != "All" && !string.IsNullOrWhiteSpace(currentVenueId)) ||
                      !string.IsNullOrWhiteSpace(currentFromDate) ||
                      !string.IsNullOrWhiteSpace(currentToDate);
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="h3 fw-bold mb-1 text-gradient"><i class="bi bi-calendar-event me-2 text-info"></i>Event Requests</h2>
        <p class="text-muted small mb-0">Browse, filter, and track incoming client event requests and venue allocations.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i> Create New Event
    </a>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Multi-Criteria Search & Filter Toolbar -->
<div class="card glass-card p-3 mb-4">
    <form asp-action="Index" method="get" class="row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label small text-muted mb-1"><i class="bi bi-search me-1"></i>Search Event / Client</label>
            <input type="text" name="searchTerm" value="@currentSearch" class="form-control form-control-sm" placeholder="Title, client name, email..." />
        </div>
        <div class="col-md-2 col-sm-6">
            <label class="form-label small text-muted mb-1"><i class="bi bi-flag me-1"></i>Status</label>
            <select name="status" class="form-select form-select-sm">
                <option value="All" selected="@(currentStatus == "All")">All Statuses</option>
                <option value="Unassigned" selected="@(currentStatus == "Unassigned")">Unassigned</option>
                <option value="Preferred Venue Selected" selected="@(currentStatus == "Preferred Venue Selected")">Preferred Venue</option>
                <option value="Booked" selected="@(currentStatus == "Booked")">Booked</option>
                <option value="Completed" selected="@(currentStatus == "Completed")">Completed</option>
                <option value="Cancelled" selected="@(currentStatus == "Cancelled")">Cancelled</option>
            </select>
        </div>
        <div class="col-md-3 col-sm-6">
            <label class="form-label small text-muted mb-1"><i class="bi bi-bank me-1"></i>Assigned Venue</label>
            <select name="venueId" class="form-select form-select-sm" asp-items="ViewBag.VenuesList">
                <option value="All">-- All Venues --</option>
            </select>
        </div>
        <div class="col-md-2 col-sm-6">
            <label class="form-label small text-muted mb-1"><i class="bi bi-calendar me-1"></i>From Date</label>
            <input type="date" name="fromDate" value="@currentFromDate" class="form-control form-control-sm" />
        </div>
        <div class="col-md-2 col-sm-6 d-flex gap-2">
            <button type="submit" class="btn btn-primary btn-sm flex-fill">
                <i class="bi bi-funnel-fill me-1"></i> Filter
            </button>
            @if (hasFilters)
            {
                <a asp-action="Index" class="btn btn-secondary btn-sm" title="Clear Filters">
                    <i class="bi bi-x-circle"></i>
                </a>
            }
        </div>
    </form>

    @if (hasFilters)
    {
        <div class="mt-2 pt-2 border-top d-flex align-items-center gap-2 small text-muted">
            <span><i class="bi bi-check2-circle text-success me-1"></i>Filters active:</span>
            <span class="badge bg-info bg-opacity-10 text-info">Found @Model.Count() event(s)</span>
            <a asp-action="Index" class="text-decoration-none text-danger small ms-auto"><i class="bi bi-arrow-counterclockwise me-1"></i>Reset All Filters</a>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="card glass-card p-5 text-center text-muted">
        <i class="bi bi-calendar-x display-3 mb-3 text-secondary"></i>
        <h4>No Events Found</h4>
        @if (hasFilters)
        {
            <p class="mb-4">No event requests match your selected filters.</p>
            <div>
                <a asp-action="Index" class="btn btn-secondary px-4 me-2"><i class="bi bi-arrow-clockwise me-1"></i> Reset Filters</a>
            </div>
        }
        else
        {
            <p class="mb-4">Log a new client event request to get started.</p>
            <div>
                <a asp-action="Create" class="btn btn-primary px-4"><i class="bi bi-plus-lg me-1"></i> Add Event</a>
            </div>
        }
    </div>
}
else
{
    <div class="table-responsive-custom mb-5">
        <table class="table table-custom table-hover">
            <thead>
                <tr>
                    <th>Poster</th>
                    <th>Event Title</th>
                    <th>Client Details</th>
                    <th>Attendance</th>
                    <th>Assigned Venue</th>
                    <th>Schedule</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var statusBadge = item.Status switch
                    {
                        "Booked" => "badge-booked",
                        "Completed" => "badge-completed",
                        "Cancelled" => "badge-cancelled",
                        "Preferred Venue Selected" => "badge-maintenance",
                        _ => "badge-unassigned"
                    };

                    var eventPoster = string.IsNullOrWhiteSpace(item.ImageUrl)
                        ? "https://images.unsplash.com/photo-1511578314322-379afb476865?auto=format&fit=crop&w=150&q=80"
                        : item.ImageUrl;

                    <tr>
                        <td style="width: 70px;">
                            <img src="@eventPoster" 
                                 alt="@item.Title" 
                                 class="rounded-3 shadow-sm" 
                                 style="width: 50px; height: 50px; object-fit: cover;"
                                 onerror="this.onerror=null; this.src='/images/default-venue.svg';" />
                        </td>
                        <td>
                            <div class="fw-bold text-dark">@item.Title</div>
                            <div class="text-muted extra-small">ID: @item.Id</div>
                        </td>
                        <td>
                            <div class="fw-semibold">@item.ClientName</div>
                            <div class="text-muted small"><i class="bi bi-envelope me-1"></i>@item.ClientEmail</div>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">
                                <i class="bi bi-people me-1 text-primary"></i>@item.ExpectedAttendance guests
                            </span>
                        </td>
                        <td>
                            @if (item.Venue != null)
                            {
                                var venueImg = string.IsNullOrWhiteSpace(item.Venue.ImageUrl) 
                                    ? "/images/default-venue.svg" 
                                    : item.Venue.ImageUrl;

                                <div class="d-flex align-items-center gap-2">
                                    <img src="@venueImg" 
                                         alt="@item.Venue.Name" 
                                         class="rounded-2 shadow-sm flex-shrink-0" 
                                         style="width: 38px; height: 38px; object-fit: cover;"
                                         onerror="this.onerror=null; this.src='/images/default-venue.svg';" />
                                    <div>
                                        <div class="fw-semibold small">@item.Venue.Name</div>
                                        <div class="text-muted extra-small">@item.Venue.Location</div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <span class="text-muted fst-italic small"><i class="bi bi-slash-circle me-1"></i>Unassigned</span>
                            }
                        </td>
                        <td>
                            <div class="small"><i class="bi bi-clock me-1 text-muted"></i>@item.StartDate.ToString("yyyy-MM-dd HH:mm")</div>
                            <div class="extra-small text-muted">to @item.EndDate.ToString("yyyy-MM-dd HH:mm")</div>
                        </td>
                        <td>
                            <span class="badge-premium @statusBadge">@item.Status</span>
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this event?');" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}