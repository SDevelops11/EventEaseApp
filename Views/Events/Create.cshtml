@model EventEaseApp.Models.Event

@{
    ViewData["Title"] = "Create Event";
}

<div class="row justify-content-center">
    <div class="col-lg-10 col-xl-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="h3 fw-bold mb-0 text-gradient"><i class="bi bi-calendar-event me-2 text-primary"></i>Create New Event</h2>
            <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i> Back to List</a>
        </div>

        <div class="card glass-card p-4 p-md-5">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="All" class="alert alert-danger mb-4" role="alert"></div>

                <div class="row g-4">
                    <!-- Left Column: Event Specs -->
                    <div class="col-md-6">
                        <h5 class="fw-semibold text-primary mb-3"><i class="bi bi-sliders me-1"></i>Event Specifications</h5>

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label">Event Title</label>
                            <input asp-for="Title" class="form-control" placeholder="e.g. Annual Tech Symposium" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EventTypeId" class="form-label">Event Category / Type</label>
                            <select asp-for="EventTypeId" class="form-select" asp-items="ViewBag.EventTypeId">
                                <option value="">-- Select Event Category --</option>
                            </select>
                            <span asp-validation-for="EventTypeId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="VenueId" class="form-label">Preferred Venue (Optional)</label>
                            <select asp-for="VenueId" class="form-select" asp-items="ViewBag.VenueId">
                                <option value="">-- No Preferred Venue / Unassigned --</option>
                            </select>
                            <span asp-validation-for="VenueId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ExpectedAttendance" class="form-label">Expected Attendance (Pax)</label>
                            <input asp-for="ExpectedAttendance" type="number" class="form-control" placeholder="e.g. 150" />
                            <span asp-validation-for="ExpectedAttendance" class="text-danger small"></span>
                        </div>

                        <!-- Event Poster / Image Upload Area -->
                        <div class="p-3 mt-3 rounded-3 border bg-light bg-opacity-50">
                            <label class="form-label d-flex justify-content-between align-items-center">
                                <span>Event Flyer / Poster Image</span>
                                <span class="badge bg-primary bg-opacity-10 text-primary small"><i class="bi bi-cloud-arrow-up me-1"></i>Azure Storage</span>
                            </label>
                            <input type="file" name="imageFile" id="eventImageFile" accept="image/*" class="form-control" onchange="previewImage(this, 'eventImgPreview', 'eventPreviewBox')" />
                            <div class="form-text extra-small text-muted mt-1">
                                Upload image directly to Azure Blob Storage or provide an external URL below.
                            </div>

                            <div class="text-center my-2 position-relative">
                                <hr class="my-2" />
                                <span class="px-2 bg-light text-muted small position-absolute top-50 start-50 translate-middle">OR</span>
                            </div>

                            <label asp-for="ImageUrl" class="form-label small">External Image / Poster URL</label>
                            <input asp-for="ImageUrl" id="eventUrlInput" class="form-control form-control-sm" placeholder="https://example.com/poster.jpg" oninput="previewUrl(this.value, 'eventImgPreview', 'eventPreviewBox')" />
                            <span asp-validation-for="ImageUrl" class="text-danger small"></span>

                            <div id="eventPreviewBox" class="mt-3 text-center d-none">
                                <div class="small fw-semibold text-muted mb-1 text-start">Poster Preview:</div>
                                <div class="rounded-3 overflow-hidden border shadow-sm" style="height: 140px; background-color: #f8fafc;">
                                    <img id="eventImgPreview" src="#" alt="Event Preview" class="w-100 h-100" style="object-fit: cover;" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column: Client & Schedule -->
                    <div class="col-md-6">
                        <h5 class="fw-semibold text-primary mb-3"><i class="bi bi-person-lines-fill me-1"></i>Client & Schedule</h5>

                        <div class="mb-3">
                            <label asp-for="ClientName" class="form-label">Client Name</label>
                            <input asp-for="ClientName" class="form-control" placeholder="e.g. John Doe" />
                            <span asp-validation-for="ClientName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ClientEmail" class="form-label">Client Email Address</label>
                            <input asp-for="ClientEmail" type="email" class="form-control" placeholder="e.g. john@example.com" />
                            <span asp-validation-for="ClientEmail" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-6 mb-3">
                                <label asp-for="StartDate" class="form-label">Starts At</label>
                                <input asp-for="StartDate" type="datetime-local" class="form-control" />
                                <span asp-validation-for="StartDate" class="text-danger small"></span>
                            </div>
                            <div class="col-6 mb-3">
                                <label asp-for="EndDate" class="form-label">Ends At</label>
                                <input asp-for="EndDate" type="datetime-local" class="form-control" />
                                <span asp-validation-for="EndDate" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end mt-4 pt-3 border-top">
                    <button type="submit" class="btn btn-primary px-4 py-2"><i class="bi bi-check-circle-fill me-1"></i> Save Event Request</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewImage(input, imgId, boxId) {
            const preview = document.getElementById(imgId);
            const box = document.getElementById(boxId);
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    preview.src = e.target.result;
                    box.classList.remove('d-none');
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        function previewUrl(url, imgId, boxId) {
            const preview = document.getElementById(imgId);
            const box = document.getElementById(boxId);
            if (url && url.trim().length > 5) {
                preview.src = url.trim();
                box.classList.remove('d-none');
            } else {
                box.classList.add('d-none');
            }
        }
    </script>
}
